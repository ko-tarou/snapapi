{
  "name": "snapapi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snapapi-db",
      "database_id": "4eb9181d-5e9c-4413-a6ba-c05f59373e73"
    }
  ]
}
